# ── Server configuration ───────────────────────────────────────────
PORT=3001
CLIENT_URL="http://localhost:5173"

# ── Database configuration ─────────────────────────────────────────
# Connection string for PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/stocksense?schema=public"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/stocksense_test?schema=public"

# ── Authentication ─────────────────────────────────────────────────
# Secret used for JWT token signing. In production, use a strong random string.
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"
