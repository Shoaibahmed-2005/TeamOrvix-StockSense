generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  MANAGER
  STAFF
}

enum LocationType {
  INTERNAL
  VENDOR
  CUSTOMER
  ADJUSTMENT
}

enum ContactType {
  VENDOR
  CUSTOMER
  BOTH
}

enum OperationType {
  RECEIPT
  DELIVERY
  INTERNAL
  ADJUSTMENT
}

enum OperationStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELLED
}

enum MoveDirection {
  IN
  OUT
  INTERNAL
  ADJUSTMENT
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique @map("login_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(MANAGER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  passwordResetOtps PasswordResetOtp[]
  operations        Operation[]         @relation("Responsible")
  stockMoves        StockMove[]

  @@map("users")
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  attempts  Int      @default(0)
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_otps")
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  shortCode String   @unique @map("short_code")
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  locations    Location[]
  operations   Operation[]
  reorderRules ReorderRule[]
  sequences    Sequence[]

  @@map("warehouses")
}

model Location {
  id          String       @id @default(cuid())
  name        String
  shortCode   String       @map("short_code")
  warehouseId String?      @map("warehouse_id")
  type        LocationType @default(INTERNAL)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  warehouse   Warehouse?  @relation(fields: [warehouseId], references: [id])
  stockQuants StockQuant[]
  sourceOps   Operation[]  @relation("SourceLocation")
  destOps     Operation[]  @relation("DestLocation")
  fromMoves   StockMove[]  @relation("FromLocation")
  toMoves     StockMove[]  @relation("ToLocation")

  @@map("locations")
}

model Contact {
  id        String      @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  type      ContactType
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  operations Operation[]
  stockMoves StockMove[]

  @@index([name])
  @@map("contacts")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products Product[]

  @@map("categories")
}

model Product {
  id         String   @id @default(cuid())
  name       String
  sku        String   @unique
  categoryId String?  @map("category_id")
  uom        String   @default("Units")
  unitCost   Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  category       Category?       @relation(fields: [categoryId], references: [id])
  stockQuants    StockQuant[]
  reorderRules   ReorderRule[]
  operationLines OperationLine[]
  stockMoves     StockMove[]

  @@index([name])
  @@index([sku])
  @@map("products")
}

model ReorderRule {
  id          String  @id @default(cuid())
  productId   String  @map("product_id")
  warehouseId String  @map("warehouse_id")
  minQty      Decimal @map("min_qty") @db.Decimal(12, 3)
  maxQty      Decimal @map("max_qty") @db.Decimal(12, 3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("reorder_rules")
}

model StockQuant {
  id               String  @id @default(cuid())
  productId        String  @map("product_id")
  locationId       String  @map("location_id")
  quantity         Decimal @default(0) @db.Decimal(12, 3)
  reservedQuantity Decimal @default(0) @map("reserved_quantity") @db.Decimal(12, 3)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@map("stock_quants")
}

model Operation {
  id                String          @id @default(cuid())
  reference         String          @unique
  type              OperationType
  status            OperationStatus @default(DRAFT)
  warehouseId       String          @map("warehouse_id")
  sourceLocationId  String?         @map("source_location_id")
  destLocationId    String?         @map("dest_location_id")
  contactId         String?         @map("contact_id")
  deliveryAddress   String?         @map("delivery_address")
  operationTypeNote String?         @map("operation_type_note")
  scheduleDate      DateTime        @map("schedule_date") @db.Timestamptz
  responsibleId     String?         @map("responsible_id")
  doneAt            DateTime?       @map("done_at") @db.Timestamptz
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id])
  sourceLocation Location?       @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destLocation   Location?       @relation("DestLocation", fields: [destLocationId], references: [id])
  contact        Contact?        @relation(fields: [contactId], references: [id])
  responsible    User?           @relation("Responsible", fields: [responsibleId], references: [id])
  lines          OperationLine[]
  stockMoves     StockMove[]

  @@index([type])
  @@index([status])
  @@index([scheduleDate])
  @@index([warehouseId])
  @@index([type, status])
  @@map("operations")
}

model OperationLine {
  id              String   @id @default(cuid())
  operationId     String   @map("operation_id")
  productId       String   @map("product_id")
  quantity        Decimal  @db.Decimal(12, 3)
  countedQuantity Decimal? @map("counted_quantity") @db.Decimal(12, 3)

  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("operation_lines")
}

model StockMove {
  id             String        @id @default(cuid())
  operationId    String?       @map("operation_id")
  reference      String
  productId      String        @map("product_id")
  fromLocationId String?       @map("from_location_id")
  toLocationId   String?       @map("to_location_id")
  quantity       Decimal       @db.Decimal(12, 3)
  contactId      String?       @map("contact_id")
  direction      MoveDirection
  status         OperationStatus @default(DONE)
  date           DateTime      @default(now()) @db.Timestamptz
  userId         String?       @map("user_id")

  operation    Operation? @relation(fields: [operationId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
  fromLocation Location?  @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location?  @relation("ToLocation", fields: [toLocationId], references: [id])
  contact      Contact?   @relation(fields: [contactId], references: [id])
  user         User?      @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([date])
  @@index([reference])
  @@index([productId, date])
  @@map("stock_moves")
}

model Sequence {
  id            String    @id @default(cuid())
  warehouseId   String    @map("warehouse_id")
  operationCode String    @map("operation_code")
  nextNumber    Int       @default(1) @map("next_number")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, operationCode])
  @@map("sequences")
}
